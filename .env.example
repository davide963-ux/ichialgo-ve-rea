# Ichialgo — market-data proxy configuration.
# Copy this file to .env and fill in ONE provider. Restart the dev/prod server after editing.
# None of these need a VITE_ prefix (except where noted) — they stay in the Node
# proxy (server/api.mjs) and are never bundled into browser code.

# Which provider the app uses: "oanda" (default, recommended) or "twelvedata".
VITE_MARKET_PROVIDER=oanda

# ── Option A: OANDA v20 ──────────────────────────────────────────────
# Practice account: oanda.com → Manage API Access → generate a token.
# Account ID format: 101-004-XXXXXXX-001
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice
# Overrides for testing against a mock server only — leave unset otherwise.
# OANDA_REST_URL=
# OANDA_STREAM_URL=

# ── Option B: Twelve Data ────────────────────────────────────────────
# ONE key (free Basic plan = 8 credits/min, 800 credits/day):
TWELVEDATA_API_KEY=

# SEVERAL keys (one per Twelve Data account) multiply that budget. The proxy
# serves from the first key that still has credits and moves to the next one
# when it runs out — 3 keys = 24 credits/min and 2400 credits/day.
# Comma-separated, in failover order:
# TWELVEDATA_API_KEYS=key_from_account_1,key_from_account_2,key_from_account_3
# …or numbered, which is easier to paste into a Vercel/host dashboard:
# TWELVEDATA_API_KEY_1=key_from_account_1
# TWELVEDATA_API_KEY_2=key_from_account_2
# TWELVEDATA_API_KEY_3=key_from_account_3

VITE_TWELVEDATA_POLL_MS=60000
# Limits PER KEY (not for the whole pool). Set the daily one to 0 on a paid plan.
VITE_TWELVEDATA_CREDITS_PER_MINUTE=8
VITE_TWELVEDATA_CREDITS_PER_DAY=800

# ── Production server (npm start) ────────────────────────────────────
PORT=8080
HOST=127.0.0.1
