# Ichialgo — market-data proxy configuration.
# Copy this file to .env. Restart the dev/prod server after editing.
#
# The API keys have NO VITE_ prefix on purpose: they stay in the Node proxy
# (server/api.mjs) and are never bundled into browser code.

# ── Twelve Data API keys ─────────────────────────────────────────────
# One key per Twelve Data account. The proxy serves from the first key that
# still has credits and fails over to the next when it runs out, so the
# numbering is the FAILOVER ORDER.
#
# Free Basic plan = 8 credits/min and 800 credits/day PER KEY.
#   5 keys → 40 credits/min, 4000 credits/day.
TWELVEDATA_API_KEY_1=
TWELVEDATA_API_KEY_2=
TWELVEDATA_API_KEY_3=
TWELVEDATA_API_KEY_4=
TWELVEDATA_API_KEY_5=

# …or as one comma-separated variable, if you prefer fewer rows:
# TWELVEDATA_API_KEYS=key_account_1,key_account_2,key_account_3

# ── Tuning ───────────────────────────────────────────────────────────
# Seconds between price refreshes. /quote costs 1 credit PER SYMBOL, so 7
# pairs cost 7 credits each refresh. Lower = fresher prices, less daily
# runtime. See the README table before changing it.
VITE_TWELVEDATA_POLL_MS=60000

# Plan limits PER KEY, not for the pool — the app multiplies by the key count
# itself. Only change these on a paid plan. Set the daily one to 0 for no cap.
VITE_TWELVEDATA_CREDITS_PER_MINUTE=8
VITE_TWELVEDATA_CREDITS_PER_DAY=800

# Override for testing against a mock server only — leave unset otherwise.
# TWELVEDATA_REST_URL=

# ── Production server (npm start) ────────────────────────────────────
PORT=8080
HOST=127.0.0.1
